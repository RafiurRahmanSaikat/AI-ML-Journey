    },
    {
      "name": "Delete section (move students first)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/sections/{{section_id}}/?move_to_section=2"
      }
    },
    {
      "name": "Create section",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/sections/",
        "body": {
          "mode": "raw",
          "raw": "{\"school_class\":\"{{class_id}}\",\"name\":\"C\",\"capacity\":60,\"active\":true}"
        }
      }
    },
    {
      "name": "Create exam",
      "request": {
